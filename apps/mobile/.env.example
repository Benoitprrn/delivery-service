# URL HTTPS de l'API Fastify (jamais d'appel direct à Supabase ou Traccar
# depuis l'app — tout passe par /api/v1/...)
EXPO_PUBLIC_API_URL=https://api.example.com

# Instance Supabase (locale en dev — même instance que apps/web/.env)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=changeme
