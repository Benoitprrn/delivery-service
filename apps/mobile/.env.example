# URL HTTPS de l'API Fastify (jamais d'appel direct à Supabase ou Traccar
# depuis l'app — tout passe par /api/v1/...)
EXPO_PUBLIC_API_URL=https://api.example.com

# Instance Supabase (locale en dev — même instance que apps/web/.env)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=changeme

# Lecteur Stripe Terminal SIMULÉ (développement uniquement ; refusé en build de production).
# Mettre `physical` pour un vrai WisePad 3.
EXPO_PUBLIC_TERMINAL_MODE=simulated

# Clé PUBLIABLE Stripe (pk_test_… / pk_live_…) pour les composants Connect embarqués (paiements du livreur).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_changeme

# Restaure le fetch natif React Native : le fetch WinterCG d'Expo SDK 57 ne sait pas
# uploader un fichier au format { uri, name, type } (lib/api.ts -> uploadMultipart).
EXPO_PUBLIC_USE_RN_FETCH=true
