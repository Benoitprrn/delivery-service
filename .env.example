NODE_ENV=development
PORT=3000

# Deux connexions PG distinctes — jamais la même (cf. §13.5 specs v6)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres          # Supavisor, transaction mode
PGBOSS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres    # connexion directe, session mode — PAS UTILISÉ EN PHASE 1

VALKEY_URL=redis://localhost:6379
OSRM_URL=http://localhost:5000

# Phase 2 — Supabase Auth
# Vérification JWT via JWKS (clés de signature asymétriques ES256, pas de
# secret partagé) : voir SUPABASE_URL + /auth/v1/.well-known/jwks.json.
SUPABASE_URL=http://127.0.0.1:54321
# Clé publique anon — utilisée par les tests et par apps/web (client Supabase
# navigateur), jamais pour vérifier des JWT côté serveur.
SUPABASE_ANON_KEY=

# Phase 2+
OPENCAGE_API_KEY=
MISTRAL_API_KEY=
STRIPE_SECRET_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
RESEND_API_KEY=
