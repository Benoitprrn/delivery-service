NODE_ENV=development
PORT=3000

# Deux connexions PG distinctes — jamais la même en production (cf. §13.5 specs v6).
# En local, le CLI Supabase n'expose qu'un seul Postgres (54322, pas de pooler
# Supavisor démarré) : les deux variables pointent donc vers le même port ici.
# En prod/hosted Supabase, PGBOSS_DATABASE_URL doit être la chaîne de connexion
# directe (session mode) fournie par Supabase, distincte du pooler Supavisor.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres          # Supavisor (prod) / direct (local), transaction mode côté API
PGBOSS_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres   # connexion directe, session mode pour pg-boss

DRIVER_SIGNUP_ZONE_ID=                                                        # zone assignée aux nouveaux livreurs à l'inscription (uuid de `zones`)

VALKEY_URL=redis://localhost:6379
OSRM_URL=http://localhost:5000
VROOM_URL=http://localhost:3010
DISPATCH_OFFER_TTL_SECONDS=60

# Phase 2 — Supabase Auth
# Vérification JWT via JWKS (clés de signature asymétriques ES256, pas de
# secret partagé) : voir SUPABASE_URL + /auth/v1/.well-known/jwks.json.
SUPABASE_URL=http://127.0.0.1:54321
# Secret API Key Supabase (remplace service_role legacy) — backend
# uniquement, jamais NEXT_PUBLIC_*. Valeur réelle : dashboard Supabase,
# Settings > API. Ne jamais committer la valeur réelle ici.
SUPABASE_SECRET_KEY=
# Clé publique anon — utilisée par les tests et par apps/web (client Supabase
# navigateur), jamais pour vérifier des JWT côté serveur.
SUPABASE_ANON_KEY=

# Phase 2+
OPENCAGE_API_KEY=
# Clé API Sirene INSEE — backend uniquement, jamais NEXT_PUBLIC_*.
INSEE_API_KEY=
# En production, active explicitement la capacité uniquement quand les deux
# secrets backend Stripe sont renseignés. Laisser à false désactive payments
# sans empêcher l’API entière de démarrer.
STRIPE_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Secret(s) de signature du webhook Connect (paiement carte à la livraison), endpoint distinct
# POST /api/v1/webhooks/stripe-connect. Facultatif : vide, la route répond 503 et son worker ne
# démarre pas. Un secret par destination d'événements Stripe pointant vers cette URL
# (destination « comptes connectés » snapshot + destination « Accounts v2 » mince),
# séparés par des virgules.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Override facultatif de la version d'API des seuls appels Stripe Accounts v2 (ex. une version .preview pour une
# plateforme sans Connect). Vide = aucune version explicite : le SDK Stripe utilise sa version GA.
STRIPE_ACCOUNTS_V2_API_VERSION=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
MISTRAL_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
RESEND_API_KEY=
# Pré-notification SEPA du lundi (R41) : DÉSACTIVÉE par défaut. À true, exige RESEND_API_KEY, RESEND_FROM_EMAIL (ex. « Locadely <facturation@…> »,
# domaine vérifié chez Resend), SEPA_CREDITOR_ID (identifiant créancier SEPA de STRIPE, jamais présenté comme celui de Locadely) et SETTLEMENT_SUPPORT_EMAIL.
SETTLEMENT_PRE_NOTIFICATION_WORKER_ENABLED=false
RESEND_FROM_EMAIL=
SEPA_CREDITOR_ID=
SETTLEMENT_SUPPORT_EMAIL=

# Stripe Terminal : lecteur SIMULÉ (remplace uniquement le matériel). Jamais true en production.
TERMINAL_ALLOW_SIMULATED_READER=false
SETTLEMENT_CLOSE_WORKER_ENABLED=false
# Prélèvement SEPA du mercredi (R50) : DÉSACTIVÉ par défaut ; à true exige STRIPE_PAYMENTS_ENABLED=true et STRIPE_SECRET_KEY.
SETTLEMENT_DEBIT_WORKER_ENABLED=false
# Paiement des livreurs (R60) : DÉSACTIVÉ par défaut ; à true exige STRIPE_PAYMENTS_ENABLED=true et STRIPE_SECRET_KEY.
SETTLEMENT_PAYOUT_WORKER_ENABLED=false
# Reversals de Transfers livreurs (R61) : DÉSACTIVÉ par défaut ; n'exécute que des reversals déjà approuvées ; exige STRIPE_PAYMENTS_ENABLED=true.
SETTLEMENT_REVERSAL_WORKER_ENABLED=false
# Webhooks plateforme du règlement (journal + traitement : déclencheurs, relecture Stripe) et réconciliation quotidienne (R70) : DÉSACTIVÉS par défaut ; exigent Stripe activé.
SETTLEMENT_WEBHOOK_WORKER_ENABLED=false
SETTLEMENT_RECONCILIATION_WORKER_ENABLED=false
# Identité légale du restaurant débiteur visible du livreur (R80). Environnement de TEST seulement : validation juridique/RGPD requise avant production.
SETTLEMENT_DRIVER_SEES_DEBTOR_IDENTITY=false
